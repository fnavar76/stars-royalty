# Copiar a .env y sustituir los valores antes de npm.cmd start.
API_PORT=4000
WEB_ORIGIN=http://localhost:4000
DATABASE_FILE=starsroyalty-production.db
SEED_DEMO=false
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
SEED_ADMIN_EMAIL=administracion@example.com
SEED_ADMIN_PASSWORD=replace-with-a-unique-password
