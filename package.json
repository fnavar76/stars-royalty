{
  "name": "starsroyalty-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "tsc -p tsconfig.server.json && node .server-dist/index.js",
    "dev:full": "concurrently \"npm run api\" \"npm run dev\"",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "start": "node scripts/start.mjs",
    "test": "tsc -p tsconfig.server.json && node scripts/release-test.mjs && node scripts/ledger-migration-test.mjs",
    "backup": "node scripts/backup.mjs",
    "ledger:check": "node scripts/verify-ledger.mjs",
    "restore:check": "node scripts/restore-check.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.47.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
